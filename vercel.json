{
  "cleanUrls": true,
  "headers": [
    { "source": "/photos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/media/(.*)",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
